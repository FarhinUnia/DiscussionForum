
@model DiscussionForum.Models.Topic

@{
    ViewData["Title"] = "Create Topic";
    ViewData["PageCss"] = "createtopic.css";
}

<div class="container create-topic-page">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="create-topic-hero">
                <h1>Create Topic</h1>
                <p>Create a topic for your discussion board.</p>

                <span class="create-topic-board-label">
                    Discussion Board: @ViewBag.BoardTitle
                </span>
            </div>

            <div class="create-topic-form-card">

                <form asp-controller="Topic"
                      asp-action="Create"
                      method="post"
                      id="createTopicForm">

                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="BoardId" />

                    <div class="mb-4">
                        <label asp-for="Title" class="form-label">
                            Topic Title
                        </label>

                        <input asp-for="Title"
                               class="form-control"
                               minlength="3"
                               maxlength="100"
                               required
                               placeholder="Enter topic title" />

                        <span asp-validation-for="Title"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">
                            Topic Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"
                                  minlength="5"
                                  maxlength="500"
                                  required
                                  placeholder="Enter topic description"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="create-topic-actions">

                       <button type="submit" id="createTopicBtn" class="btn btn-primary">
    Create Topic
</button>

                        <a asp-controller="DiscussionBoard"
                           asp-action="ViewDiscussion"
                           asp-route-id="@ViewBag.BoardId"
                           class="create-topic-cancel">
                            Back to Discussion Board
                        </a>

                    </div>

                </form>

            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function checkForm() {
            var title = $("#Title").val().trim();
            var description = $("#Description").val().trim();

            var valid =
                title.length >= 3 &&
                title.length <= 100 &&
                description.length >= 5 &&
                description.length <= 500;

            $("#createTopicBtn").prop("disabled", !valid);
        }

        $(document).ready(function () {
            $("#Title, #Description").on("input", checkForm);

            checkForm();
        });
    </script>
}
