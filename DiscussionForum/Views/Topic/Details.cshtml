
@model DiscussionForum.Models.Topic

@{
    ViewData["Title"] = "Topic Details";
    ViewData["PageCss"] = "topicdetails.css";
}

<div class="topic-details-page">

    <div class="topic-details-hero">
        <h1>@Model.Title</h1>

        <p class="topic-details-description">
            @Model.Description
        </p>

        <span class="topic-board-label">
            Discussion Board: @(Model.DiscussionBoard?.Title ?? "Discussion Board")
        </span>
    </div>

    <div class="topic-information">
        <div class="topic-info-card">
            <span>Topic ID</span>
            <strong>@Model.TopicId</strong>
        </div>

        <div class="topic-info-card">
            <span>Created On</span>
            <strong>@Model.CreatedDate.ToString("MMM dd, yyyy")</strong>
        </div>
    </div>

    
<div class="topic-replies-section">
    <h2>Replies (@Model.Replies.Count)</h2>

    @if (Model.Replies.Any(r => r.ParentReplyId == null))
    {
        @foreach (var reply in Model.Replies
            .Where(r => r.ParentReplyId == null)
            .OrderBy(r => r.CreatedDate))
        {
            <div class="topic-reply-card">
                <p>@reply.Content</p>

                <small>
                    Posted on @reply.CreatedDate.ToString("MMM dd, yyyy h:mm tt")
                </small>

                <button type="button"
        class="reply-button"
        onclick="toggleReplyForm(@reply.ReplyId)">
    Reply
</button>

                <form asp-controller="Topic"
                      asp-action="PostReply"
                      method="post"
                      id="reply-form-@reply.ReplyId"
                      style="display:none; margin-top:12px;">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="topicId"
                           value="@Model.TopicId" />

                    <input type="hidden"
                           name="parentReplyId"
                           value="@reply.ReplyId" />

                    <textarea name="content"
                              class="form-control mb-2"
                              rows="3"
                              maxlength="1000"
                              required
                              placeholder="Write your reply..."></textarea>

                    <button type="submit" class="btn btn-primary btn-sm">
                        Post Reply
                    </button>
                </form>

                @foreach (var child in Model.Replies
                    .Where(r => r.ParentReplyId == reply.ReplyId)
                    .OrderBy(r => r.CreatedDate))
                {
                   <div class="topic-threaded-reply">

                        <p>@child.Content</p>

                        <small>
                            Posted on @child.CreatedDate.ToString("MMM dd, yyyy h:mm tt")
                        </small>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="no-replies-message">
            <h3>No replies yet</h3>
            <p>Be the first to reply to this topic.</p>
        </div>
    }
</div>

<script>
    function toggleReplyForm(replyId) {
        var form = document.getElementById("reply-form-" + replyId);

        if (form) {
            form.style.display =
                form.style.display === "none" ? "block" : "none";
        }
    }
</script>

    <div class="post-reply-section">
        <h2>Post a Reply</h2>

        <form asp-controller="Topic"
              asp-action="PostReply"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" name="topicId" value="@Model.TopicId" />

            <div class="mb-3">
                <label for="content" class="form-label">Your Reply</label>

                <textarea id="content"
                          name="content"
                          class="form-control"
                          rows="4"
                          maxlength="1000"
                          required
                          placeholder="Write your reply here..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary">
                Post Reply
            </button>
        </form>
    </div>

    <div class="topic-details-actions">
        <a asp-controller="DiscussionBoard"
           asp-action="ViewDiscussion"
           asp-route-id="@Model.BoardId"
           class="back-to-board-btn">
            ← Back to Discussion Board
        </a>

        <a asp-controller="DiscussionBoard"
           asp-action="Index"
           class="back-to-boards-btn">
            All Discussion Boards
        </a>
    </div>

</div>
