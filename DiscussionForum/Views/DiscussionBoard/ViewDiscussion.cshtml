@model DiscussionForum.Models.DiscussionBoard

@{
    ViewData["PageCss"] = "viewdiscussion.css";
    ViewData["Title"] = "View Discussion";
}

<div class="view-discussion-page">

    <div class="view-discussion-hero">
        <h1>@Model.Title</h1>

        <p>@Model.Description</p>

        <span class="view-course-info">
            Course ID: @Model.CourseId
        </span>
    </div>

    <div class="topics-section-header">
        <div>
            <h2>Discussion Topics</h2>
            <p>Explore topics and join the conversation.</p>
        </div>

        <a asp-controller="Topic"
           asp-action="Create"
           asp-route-boardId="@Model.BoardId"
           class="create-topic-btn">
            + Create Topic
        </a>
    </div>

    @if (Model.Topics != null && Model.Topics.Any())
    {
        @foreach (var topic in Model.Topics.OrderByDescending(t => t.CreatedDate))
        {
            <div class="view-topic-card">

                <h3>
                    <a asp-controller="Topic"
                       asp-action="Details"
                       asp-route-id="@topic.TopicId">
                        @topic.Title
                    </a>
                </h3>

                <p class="view-topic-description">
                    @topic.Description
                </p>

                <div class="view-topic-footer">
                    <span>
                        Created: @topic.CreatedDate.ToString("yyyy-MM-dd HH:mm")
                    </span>

                    <a asp-controller="Topic"
                       asp-action="Details"
                       asp-route-id="@topic.TopicId"
                       class="view-topic-link">
                        View Topic →
                    </a>
                </div>

            </div>
        }
    }
    else
    {
        <div class="no-topics-message">
            <h3>No topics yet</h3>
            <p>Be the first to start a discussion on this board.</p>
        </div>
    }

    <a asp-controller="DiscussionBoard"
       asp-action="Index"
       class="back-discussions-btn">
        ← Back to Discussion Boards
    </a>

</div>
